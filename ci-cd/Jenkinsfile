pipeline {
    agent any

    environment {
        IMAGE_NAME = 'demo-ci-cd'
        IMAGE_TAG = "build-${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    set -eux

                    python3 -m venv venv
                    . venv/bin/activate

                    python -m pip install --upgrade pip
                    pip install -r requirements.txt
                '''
            }
        }

        stage('Unit Test') {
            steps {
                sh '''
                    set -eux

                    . venv/bin/activate
                    pytest -v app --junitxml=test-results.xml
                '''
            }

            post {
                always {
                    junit 'test-results.xml'
                }
            }
        }

        stage('Check Docker') {
            steps {
                sh '''
                    set -eux

                    docker --version
                    docker info
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    set -eux

                    echo "Building image:"
                    echo "${IMAGE_NAME}:${IMAGE_TAG}"

                    docker build \
                        -t "${IMAGE_NAME}:${IMAGE_TAG}" \
                        -t "${IMAGE_NAME}:latest" \
                        .
                '''
            }
        }
    }

    post {
        success {
            echo "Pipeline succeeded"
        }

        failure {
            echo "Pipeline failed"
        }
    }
}