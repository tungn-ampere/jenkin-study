pipeline{
    agent any
    stages {
        stage('Checkout scm'){
            steps {
                checkout scm
            }
        }

        stage("Show Source"){
            steps {
                sh '''
                    echo "Current directory:"
                    pwd
                '''
            }
        }
        
        stage("Install Dependencies"){
            steps {
                sh '''
                    python3 -m venv venv
                    . venv/bin/activate
                    python -m pip install --upgrade pip
                    pip install -r requirements.txt
                '''
            }
        }

        stage("Test"){
            steps{
                sh '''
                    pytest -v ci-cd/app
                '''
            }
        }
    }
}